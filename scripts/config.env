# 配置文件
# 定义Agent的工作区路径和其他配置

# 主配置目录
AGENTS_ROOT="${AGENTS_ROOT:-$HOME/.agents}"

# Agent数据目录
AGENTS_DATA_DIR="${AGENTS_DATA_DIR:-$AGENTS_ROOT/agents}"

# 全局人格文件（所有Agent的默认基础）
GLOBAL_PERSONA="${GLOBAL_PERSONA:-$AGENTS_ROOT/GLOBAL.md}"

# 默认Agent名称
DEFAULT_AGENT="${DEFAULT_AGENT:-default}"

# 可选：Agent工作区路径（如果Agent指定了自己的配置位置）
# 格式：AGENT_WORKSPACE_<agent_name>="/path/to/workspace"
# 例如：AGENT_WORKSPACE_researcher="$HOME/.openclaw/workspace"

# 常见工具的默认路径
OPENCLAW_DIR="${OPENCLAW_DIR:-$HOME/.openclaw/workspace}"
CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
